{
    "manifest_version": 3,
    "name": "VRC Worlds Manager Helper",
    "version": "1.1",
    "description": "Open VRChat world links in VRC Worlds Manager, and mark tweets about worlds already in it",
    "permissions": [
        "contextMenus",
        "tabs",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://vrchat.com/*"
            ],
            "js": [
                "content.js"
            ]
        },
        {
            "matches": [
                "https://x.com/*",
                "https://twitter.com/*"
            ],
            "js": [
                "vwm-match.js",
                "twitter.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
